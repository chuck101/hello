def finalize(con: sqlite3.Connection) -> None:
    print("Optimizing SQLite...")
    con.execute("ANALYZE")
    con.execute("PRAGMA optimize")
    con.commit()
    con.execute("VACUUM")


def download_file(url: str, dest: Path, refresh: bool = False) -> Path:
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists() and dest.stat().st_size > 0 and not refresh:
        print(f"Using cached: {dest} ({dest.stat().st_size / 1024 / 1024:.1f} MiB)")
        return dest

    tmp = dest.with_suffix(dest.suffix + ".part")
    if tmp.exists():
        tmp.unlink()

    print(f"Downloading: {url}")
    req = urllib.request.Request(url, headers={"User-Agent": "pl-places-db-builder/2.1"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r, open(tmp, "wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            done = 0
            last_pct = -1
            while True:
                chunk = r.read(1024 * 1024)
                if not chunk:
                    break
                f.write(chunk)
                done += len(chunk)
                if total:
                    pct = int(done * 100 / total)
                    if pct >= last_pct + 5 or pct == 100:
                        print(f"  {pct:3d}%  {done / 1024 / 1024:.1f}/{total / 1024 / 1024:.1f} MiB")
                        last_pct = pct
                elif done % (50 * 1024 * 1024) < len(chunk):
                    print(f"  {done / 1024 / 1024:.1f} MiB")
    except (urllib.error.URLError, urllib.error.HTTPError) as e:
        if tmp.exists():
            tmp.unlink()
        raise RuntimeError(f"Cannot download {url}: {e}") from e

    tmp.replace(dest)
    print(f"Saved: {dest} ({dest.stat().st_size / 1024 / 1024:.1f} MiB)")
    return dest


def auto_download_bdot(cache_dir: str, refresh: bool = False) -> tuple[str, str]:
    cache = Path(cache_dir).expanduser().resolve()
    files = {}
    for cls in BDOT_AUTO_CLASSES:
        url = f"{BDOT_GEOPARQUET_BASE}/{cls}.parquet"
        files[cls] = download_file(url, cache / f"{cls}.parquet", refresh=refresh)
    return str(files["OT_ADMS_A"]), str(files["OT_SKJZ_L"])


def resolve_bdot_sources(root: Optional[str], explicit_places: Optional[str], explicit_roads: Optional[str], cache_dir: str, refresh: bool = False) -> tuple[str, str]:
    if explicit_places and explicit_roads:
        return str(Path(explicit_places).expanduser().resolve()), str(Path(explicit_roads).expanduser().resolve())

    if not root:
        return auto_download_bdot(cache_dir, refresh=refresh)
    p = Path(root).expanduser().resolve()
    if not p.exists():
        raise SystemExit(f"BDOT path not found: {p}")

    if p.is_file():
        if p.suffix.lower() != ".gpkg":
            raise SystemExit("--bdot must point to an unpacked directory or a .gpkg file")
        layers = [norm(x.name) for x in list_layers(str(p))]
        if any(norm("OT_ADMS_A") == x or norm("OT_ADMS_A") in x for x in layers) and any(norm("OT_SKJZ_L") == x or norm("OT_SKJZ_L") in x for x in layers):
            return str(p), str(p)
        raise SystemExit("Single GPKG does not contain both OT_ADMS_A and OT_SKJZ_L. Use --bdot with the unpacked country package directory or pass --bdot-places and --bdot-roads.")

    def choose(pattern: str) -> str:
        matches = [x for x in p.rglob("*.gpkg") if norm(pattern) in norm(x.name)]
        if not matches:
            raise SystemExit(f"Cannot find *{pattern}*.gpkg under {p}")
        matches.sort(key=lambda x: x.stat().st_size, reverse=True)
        if len(matches) > 1:
            print(f"WARN: found {len(matches)} files for {pattern}; choosing largest: {matches[0]}", file=sys.stderr)
        return str(matches[0])

    return choose("OT_ADMS_A"), choose("OT_SKJZ_L")


def main() -> int:
    ap = argparse.ArgumentParser(description="Build compact Poland locality/admin/road-entry DB for Android")
    ap.add_argument("--bdot", default=None, help="Optional local BDOT10k directory/GPKG. If omitted, only required classes are downloaded automatically")
    ap.add_argument("--bdot-places", default=None, help="Optional explicit OT_ADMS_A GPKG/GeoParquet")
    ap.add_argument("--bdot-roads", default=None, help="Optional explicit OT_SKJZ_L GPKG/GeoParquet")
    ap.add_argument("--cache-dir", default=".cache/bdot10k", help="Cache for automatically downloaded BDOT10k class files")
    ap.add_argument("--refresh", action="store_true", help="Redownload cached BDOT10k class files")
    ap.add_argument("--out", default="poland_places.db", help="Output SQLite DB")
    ap.add_argument("--prg", default=None, help="Optional local PRG vector dataset; otherwise official PRG WFS is used")
    ap.add_argument("--place-simplify-m", type=float, default=5.0, help="Locality polygon simplification in meters")
    ap.add_argument("--admin-simplify-m", type=float, default=3.0, help="PRG polygon simplification in meters")
    ap.add_argument("--tile-km", type=int, default=40, help="Road processing tile size (used for non-Parquet road sources)")
    ap.add_argument("--dedupe-m", type=float, default=12.0, help="Merge road/boundary crossing points closer than this")
    args = ap.parse_args()

    place_source, road_source = resolve_bdot_sources(args.bdot, args.bdot_places, args.bdot_roads, args.cache_dir, args.refresh)
    out = Path(args.out).expanduser().resolve()

    started = time.time()
    print(f"BDOT places source: {place_source}")
    print(f"BDOT roads source : {road_source}")
    place_layer, road_layer, cols = inspect_bdot(place_source, road_source)
    prg_source = open_prg_source(args.prg)

    try:
        _ = list_layers(prg_source)
    except Exception:
        if not args.prg and prg_source.startswith("WFS:"):
            prg_source = WFS_PRG
            _ = list_layers(prg_source)
        else:
            raise

    con = db_create(out)
    add_meta(con, "schema", "pl_places_v1")
    add_meta(con, "generated_utc", datetime.now(timezone.utc).isoformat())
    add_meta(con, "area_cell_deg", AREA_CELL_DEG)
    add_meta(con, "entry_cell_deg", ENTRY_CELL_DEG)
    add_meta(con, "bdot_places_file", Path(place_source).name)
    add_meta(con, "bdot_roads_file", Path(road_source).name)
    add_meta(con, "place_simplify_m", args.place_simplify_m)
    add_meta(con, "admin_simplify_m", args.admin_simplify_m)
    add_meta(con, "entry_dedupe_m", args.dedupe_m)

    print("Encoding locality and administrative polygons...")
    places, place_ids, _ = add_areas(
        con, place_source, place_layer, cols, prg_source,
        args.place_simplify_m, args.admin_simplify_m,
    )

    print("Computing road x locality-boundary crossing points...")
    entries = build_entries(
        con, road_source, road_layer, cols, places, place_ids,
        args.tile_km * 1000, args.dedupe_m,
    )
    add_meta(con, "entry_count", entries)

    finalize(con)
    area_count = con.execute("SELECT count(*) FROM area").fetchone()[0]
    place_count = con.execute("SELECT count(*) FROM area WHERE level=0").fetchone()[0]
    cells = con.execute("SELECT count(*) FROM area_cell").fetchone()[0]
    con.close()

    if place_count == 0 or entries == 0:
        raise RuntimeError(f"Invalid output database: places={place_count}, road_entries={entries}")

    size_mb = out.stat().st_size / (1024 * 1024)
    elapsed = time.time() - started
    print("\nDONE")
    print(f"  DB            : {out}")
    print(f"  size          : {size_mb:.1f} MiB")
    print(f"  areas         : {area_count}")
    print(f"  places        : {place_count}")
    print(f"  area cells    : {cells}")
    print(f"  road entries  : {entries}")
    print(f"  elapsed       : {elapsed/60:.1f} min")
    return 0
