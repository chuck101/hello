_col)
            table = batch.to_pandas()
            crs = geo.get("columns", {}).get(geom_col, {}).get("crs")
            table[geom_col] = gpd.GeoSeries.from_wkb(table[geom_col], crs=crs)
            return gpd.GeoDataFrame(table, geometry=geom_col, crs=crs).head(max_features).copy()

        kwargs = {}
        if bbox_ is not None:
            kwargs["bbox"] = bbox_
        return gpd.read_parquet(source, columns=read_cols, **kwargs)

    return pyogrio.read_dataframe(
        source,
        layer=layer,
        columns=columns,
        bbox=bbox_,
        max_features=max_features,
        use_arrow=False,
    )


def source_crs(source: str, layer: str) -> CRS:
    if str(source).lower().endswith(".parquet"):
        geom_col, geo = parquet_geo_meta(source)
        crs = geo.get("columns", {}).get(geom_col, {}).get("crs")
        if not crs:
            raise RuntimeError(f"Source has no CRS in GeoParquet metadata: {source}")
        return CRS.from_user_input(crs)
    info = pyogrio.read_info(source, layer=layer)
    return CRS.from_user_input(info["crs"])

def ensure_crs(gdf: gpd.GeoDataFrame, epsg: int) -> gpd.GeoDataFrame:
    if gdf.crs is None:
        raise RuntimeError("Layer has no CRS")
    if CRS.from_user_input(gdf.crs).to_epsg() == epsg:
        return gdf
    return gdf.to_crs(epsg=epsg)


def clean_polygonal(g):
    if g is None or g.is_empty:
        return None
    if not g.is_valid:
        g = make_valid(g)
    if isinstance(g, Polygon):
        return g
    if isinstance(g, MultiPolygon):
        return g
    if isinstance(g, GeometryCollection):
        polys = [x for x in g.geoms if isinstance(x, Polygon)]
        if not polys:
            return None
        return MultiPolygon(polys) if len(polys) > 1 else polys[0]
    return None


def polygon_iter(g) -> Iterator[Polygon]:
    if isinstance(g, Polygon):
        yield g
    elif isinstance(g, MultiPolygon):
        yield from g.geoms


def encode_polygon_geom(g_wgs84, scale: int = 1_000_000) -> bytes:
    """Encode Polygon/MultiPolygon to a tiny zlib-compressed binary blob."""
    polys = list(polygon_iter(g_wgs84))
    b = bytearray(b"PG1")
    b += struct.pack("<I", len(polys))
    for poly in polys:
        rings = [poly.exterior, *poly.interiors]
        b += struct.pack("<I", len(rings))
        for ring in rings:
            coords = list(ring.coords)
            # Shapely closes rings by repeating first vertex. Decoder closes implicitly.
            if len(coords) > 1 and coords[0] == coords[-1]:
                coords.pop()
            b += struct.pack("<I", len(coords))
            if not coords:
                continue
            lon0, lat0 = coords[0]
            prev_lat = int(round(lat0 * scale))
            prev_lon = int(round(lon0 * scale))
            b += struct.pack("<ii", prev_lat, prev_lon)
            for lon, lat in coords[1:]:
                ilat = int(round(lat * scale))
                ilon = int(round(lon * scale))
                b += struct.pack("<ii", ilat - prev_lat, ilon - prev_lon)
                prev_lat, prev_lon = ilat, ilon
    return zlib.compress(bytes(b), level=9)


def geom_bbox_e6(g) -> tuple[int, int, int, int]:
    minx, miny, maxx, maxy = g.bounds
    return (
        int(math.floor(miny * 1_000_000)),
        int(math.floor(minx * 1_000_000)),
        int(math.ceil(maxy * 1_000_000)),
        int(math.ceil(maxx * 1_000_000)),
    )


def cell_range_from_bounds(bounds, cell_deg: float) -> Iterator[tuple[int, int]]:
    minx, miny, maxx, maxy = bounds  # lon, lat
    x0 = math.floor(minx / cell_deg)
    x1 = math.floor(maxx / cell_deg)
    y0 = math.floor(miny / cell_deg)
    y1 = math.floor(maxy / cell_deg)
    for cx in range(x0, x1 + 1):
        for cy in range(y0, y1 + 1):
            yield cx, cy


def db_create(path: Path) -> sqlite3.Connection:
    if path.exists():
        path.unlink()
    con = sqlite3.connect(path)
    con.execute("PRAGMA journal_mode=OFF")
    con.execute("PRAGMA synchronous=OFF")
    con.execute("PRAGMA temp_store=MEMORY")
    con.execute("PRAGMA page_size=4096")
    con.executescript(
        """
        CREATE TABLE meta (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        );

        CREATE TABLE area (
            id INTEGER PRIMARY KEY,
            level INTEGER NOT NULL,       -- 0 place, 1 gmina, 2 powiat, 3 wojewodztwo
            name TEXT NOT NULL,
            subtype TEXT,
            teryt TEXT,
            rep_lat_e6 INTEGER NOT NULL,
            rep_lon_e6 INTEGER NOT NULL,
            min_lat_e6 INTEGER NOT NULL,
            min_lon_e6 INTEGER NOT NULL,
            max_lat_e6 INTEGER NOT NULL,
            max_lon_e6 INTEGER NOT NULL,
            geom_zlib BLOB NOT NULL
        );

        CREATE TABLE area_cell (
            cell_x INTEGER NOT NULL,
            cell_y INTEGER NOT NULL,
            area_id INTEGER NOT NULL,
            PRIMARY KEY (cell_x, cell_y, area_id)
        ) WITHOUT ROWID;

        CREATE TABLE entry (
            id INTEGER PRIMARY KEY,
            place_id INTEGER NOT NULL,
            lat_e6 INTEGER NOT NULL,
            lon_e6 INTEGER NOT NULL,
            cell_x INTEGER NOT NULL,
            cell_y INTEGER NOT NULL,
            road_axis_deg INTEGER,
            road_name TEXT,
            road_ref TEXT,
            road_class TEXT,
            source_road_id TEXT
        );

        CREATE INDEX idx_area_level ON area(level);
        CREATE INDEX idx_area_cell_xy ON area_cell(cell_x, cell_y);
        CREATE INDEX idx_entry_cell_xy ON entry(cell_x, cell_y);
        CREATE INDEX idx_entry_place ON entry(place_id);
        CREATE INDEX idx_entry_lat ON entry(lat_e6);
        CREATE INDEX idx_entry_lon ON entry(lon_e6);
        """
    )
    return con


def add_meta(con: sqlite3.Connection, key: str, value: object) -> None:
    con.execute("INSERT OR REPLACE INTO meta(key,value) VALUES (?,?)", (key, str(value)))


